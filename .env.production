# ============================================================
#  EVA Finance Assistant — Template .env untuk VPS Production
#
#  Cara pakai di VPS:
#    cp .env.production .env
#    nano .env   ← isi semua nilai yang kosong
#
#  JANGAN commit file .env (yang sudah diisi) ke GitHub!
#  File ini (.env.production) aman di-commit karena tidak berisi secret.
# ============================================================

AGENT_ID=eva

# ── LLM Provider ─────────────────────────────────────────────
# "ollama"  → PC lokal R&D dengan GPU
# "hermes"  → Hermes Agent di VPS (production) ← PAKAI INI
LLM_PROVIDER=hermes
LLM_BASE_URL=https://ai.hajid.dev/v1
LLM_API_KEY=
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT=60

# ── ElevenLabs TTS (copy dari .env lokal kamu) ───────────────
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Groq (untuk OCR struk) ───────────────────────────────────
GROQ_API_KEY=

# ── Storage (folder tempat dokumen finance disimpan) ─────────
STORAGE_DIR=/var/www/eva-finance/storage-data
JWT_SECRET_KEY=fabe0d2a7cb47b7c7d20c74996fa441d42849ffb1f773cdf8a6849a54f60a126
USERS_FILE=/var/www/eva-finance/users.json
# ── Skills ───────────────────────────────────────────────────
SKILLS_DIR=./skills

# ── TTS ──────────────────────────────────────────────────────
TTS_ENABLED=true
